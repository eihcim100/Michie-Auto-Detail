<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SMS Dispatcher - Michie Auto Detailing</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #334155;
        }
        .btn-primary {
            background-color: #2563eb;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
            width: 100%;
        }
        .btn-primary:hover:not(:disabled) {
            background-color: #1d4ed8;
            transform: translateY(-2px);
        }
        .btn-primary:disabled {
            background-color: #94a3b8;
            cursor: not-allowed;
        }
        input, select, textarea {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid #cbd5e1;
            border-radius: 0.5rem;
            background-color: #ffffff;
            margin-top: 0.25rem;
        }
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
        }
    </style>
</head>
<body class="p-6">

    <div class="max-w-3xl mx-auto bg-white p-8 rounded-xl shadow-xl border border-slate-200">
        <div class="flex items-center gap-4 mb-8 border-b pb-4">
            <h1 class="text-3xl font-bold text-slate-800">SMS Dispatcher 📱</h1>
        </div>

        <form id="sms-form" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="font-medium text-slate-700">Client First Name <span class="text-red-500">*</span></label>
                    <input type="text" id="first_name" placeholder="e.g. John" required>
                </div>
                <div>
                    <label class="font-medium text-slate-700">Client Cell Phone <span class="text-red-500">*</span></label>
                    <input type="tel" id="phone" placeholder="(555) 555-5555" required>
                </div>
                <div class="md:col-span-2">
                    <label class="font-medium text-slate-700">Vehicle Year, Make, & Model <span class="text-slate-400 font-normal">(Optional)</span></label>
                    <input type="text" id="vehicle_info" placeholder="e.g. 2020 Honda Civic">
                </div>
            </div>

            <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
                <label class="font-medium text-slate-700 block mb-3 text-lg">Select Message Type <span class="text-red-500">*</span></label>
                <div class="space-y-3">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="radio" name="message_type" value="interior" class="w-5 h-5 text-blue-600" required>
                        <span class="text-slate-700 font-medium">Interior Detail Link</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="radio" name="message_type" value="full" class="w-5 h-5 text-blue-600">
                        <span class="text-slate-700 font-medium">Full Detail Link</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="radio" name="message_type" value="confirmation" class="w-5 h-5 text-blue-600">
                        <span class="text-slate-700 font-medium">Appointment Confirmation Text</span>
                    </label>
                </div>
            </div>

            <div id="confirmation-fields" class="hidden bg-blue-50 p-4 rounded-lg border border-blue-100 space-y-4">
                <h3 class="font-bold text-blue-800 border-b border-blue-200 pb-2">Confirmation Details</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="font-medium text-slate-700">Date Booked <span class="text-red-500">*</span></label>
                        <input type="date" id="conf_date">
                    </div>
                    <div>
                        <label class="font-medium text-slate-700">Time Booked <span class="text-red-500">*</span></label>
                        <input type="time" id="conf_time">
                    </div>
                    <div>
                        <label class="font-medium text-slate-700">Service Booked <span class="text-red-500">*</span></label>
                        <select id="conf_service">
                            <option value="">Select Service...</option>
                            <option value="Interior Only level 1">Interior Only level 1</option>
                            <option value="Interior Only level 2">Interior Only level 2</option>
                            <option value="Interior Only level 3">Interior Only level 3</option>
                            <option value="Level 1 Detail">Level 1 Detail</option>
                            <option value="Level 2 Detail">Level 2 Detail</option>
                            <option value="Level 3 Detail">Level 3 Detail</option>
                            <option value="Custom detail service">Custom detail service</option>
                        </select>
                    </div>
                    <div>
                        <label class="font-medium text-slate-700">Vehicle Type <span class="text-red-500">*</span></label>
                        <select id="conf_vehicle_type">
                            <option value="">Select Type...</option>
                            <option value="Car">Car</option>
                            <option value="Truck">Truck</option>
                            <option value="SUV">SUV</option>
                        </select>
                    </div>
                </div>
            </div>

            <div>
                <label class="font-medium text-slate-700 block mb-2">Message Preview:</label>
                <textarea id="message_preview" rows="8" readonly class="bg-gray-100 text-sm text-gray-600 resize-none"></textarea>
            </div>

            <button type="submit" id="send-btn" class="btn-primary" disabled>Fill out required fields to send</button>
            <p id="status-message" class="text-center mt-2 font-medium"></p>
        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('sms-form');
            const typeRadios = document.getElementsByName('message_type');
            const confirmationFields = document.getElementById('confirmation-fields');
            const previewArea = document.getElementById('message_preview');
            const sendBtn = document.getElementById('send-btn');
            const statusMsg = document.getElementById('status-message');

            // Inputs
            const firstNameInput = document.getElementById('first_name');
            const phoneInput = document.getElementById('phone');
            const vehicleInfoInput = document.getElementById('vehicle_info');
            const confDateInput = document.getElementById('conf_date');
            const confTimeInput = document.getElementById('conf_time');
            const confServiceInput = document.getElementById('conf_service');
            const confVehicleTypeInput = document.getElementById('conf_vehicle_type');

            // Listen for changes to toggle confirmation fields and update preview
            form.addEventListener('input', updatePreview);
            
            typeRadios.forEach(radio => {
                radio.addEventListener('change', (e) => {
                    if (e.target.value === 'confirmation') {
                        confirmationFields.classList.remove('hidden');
                        // Make confirmation fields required
                        confDateInput.required = true;
                        confTimeInput.required = true;
                        confServiceInput.required = true;
                        confVehicleTypeInput.required = true;
                    } else {
                        confirmationFields.classList.add('hidden');
                        // Remove required attribute
                        confDateInput.required = false;
                        confTimeInput.required = false;
                        confServiceInput.required = false;
                        confVehicleTypeInput.required = false;
                    }
                    updatePreview();
                });
            });

            function formatTime(timeStr) {
                if (!timeStr) return '';
                const [hourString, minute] = timeStr.split(':');
                let hour = parseInt(hourString);
                const ampm = hour >= 12 ? 'PM' : 'AM';
                hour = hour % 12 || 12;
                return `${hour}:${minute} ${ampm}`;
            }

            function formatDate(dateStr) {
                if (!dateStr) return '';
                const [year, month, day] = dateStr.split('-');
                return `${month}/${day}/${year}`;
            }

            function generateMessage() {
                const name = firstNameInput.value.trim() || '[NAME]';
                const vehicleRaw = vehicleInfoInput.value.trim();
                const vehicleText = vehicleRaw ? ` ${vehicleRaw}` : ' vehicle';
                
                let selectedType = null;
                for (const radio of typeRadios) {
                    if (radio.checked) selectedType = radio.value;
                }

                if (!selectedType) return "Please select a message type.";

                if (selectedType === 'interior') {
                    return `Hey ${name} it's Andrew with Michie Auto Detailing! here's a link to book your interior only detail appointment for your${vehicleText} https://michieauto.com/interior`;
                } 
                
                if (selectedType === 'full') {
                    return `Hey ${name} it's Andrew with Michie Auto Detailing! Here's a link to book your auto detail appointment for your${vehicleText} https://michieauto.com/book`;
                } 
                
                if (selectedType === 'confirmation') {
                    const date = formatDate(confDateInput.value) || '[MM/DD/YYYY]';
                    const time = formatTime(confTimeInput.value) || '[Time IN 12 hour AM OR PM FORMAT]';
                    const service = confServiceInput.value || '[Package selected]';
                    
                    return `Hi ${name} it's Michie Auto Detailing, Thanks for booking with us, your ${service} detail is confirmed for ${date} at ${time}\n\nHere's a few reminders for your appointment:\n\nPlease remove all important valuables, personal items, documents out of your vehicle before we start the shampoo. (This includes all gold cash & jewelry, personal documents and registration paperwork) if there is trash you'd like us to throw away, leave it inside! We are not responsible for any items left behind in the vehicle.\n\nNote: We will use your power outlet for our equipment. Please direct us upon arrival where we should go to connect to the power. We have a very long extension cable to connect to any outlet outside or inside the garage if needed.\n\nThe detail process can take 1 to 3 hours and you keep the keys! You do not need to be there the entire time while we detail.\n\nIMPORTANT: When we're finished up, we ask before we leave that you check everything over and meeting your expectations for the ${service} package you selected. If you need us to come back, return trips will result in a $100 transportation fee charged.\n\nYour booking includes (1) free reschedule. If you need to change your appointment date or time please let us know ASAP so we can get you our soonest available slot.\n\nAnd lastly, if you have any questions or concerns call our 24/7 support line at (405) 295-5189\n\nThank you for booking with us!\nMichie Auto Detail\nhttps://michieauto.com\n(405) 295-5189`;
                }
            }

            function updatePreview() {
                const message = generateMessage();
                previewArea.value = message;

                // Basic validation to enable/disable send button
                const isFormValid = form.checkValidity();
                if (isFormValid) {
                    sendBtn.disabled = false;
                    sendBtn.textContent = 'Send Text Message 🚀';
                } else {
                    sendBtn.disabled = true;
                    sendBtn.textContent = 'Fill out required fields to send';
                }
            }

            // Handle Submission
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const phoneRaw = phoneInput.value;
                // Strip non-digits and add +1 just like original code
                const formattedPhone = `+1${phoneRaw.replace(/\D/g, '')}`; 
                const messageToSend = generateMessage();

                sendBtn.disabled = true;
                sendBtn.textContent = 'Sending...';
                statusMsg.textContent = '';

                try {
                    const response = await fetch('https://client-notifications.onrender.com/send-sms', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ 
                            to: formattedPhone, 
                            message_body: messageToSend 
                        })
                    });

                    if (response.ok) {
                        statusMsg.textContent = '✅ Message sent successfully!';
                        statusMsg.className = 'text-center mt-2 font-medium text-green-600';
                        // Optional: form.reset(); updatePreview();
                    } else {
                        throw new Error('Failed to send');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    statusMsg.textContent = '❌ Error sending message. Please try again.';
                    statusMsg.className = 'text-center mt-2 font-medium text-red-600';
                } finally {
                    sendBtn.disabled = false;
                    sendBtn.textContent = 'Send Text Message 🚀';
                }
            });

            // Initialize Preview
            updatePreview();
        });
    </script>
</body>
</html>
